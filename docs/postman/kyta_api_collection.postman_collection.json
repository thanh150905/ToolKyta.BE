  "item": [
    {
      "name": "1. eAccount (Auth & Quản lý phiên)",
      "description": "Phân hệ xác thực tài khoản và quản lý token người dùng.",
      "item": [
        {
          "name": "Đăng nhập (Tự động lấy & lưu Access Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tự động bắt access_token và lưu vào biến collection",
                  "const res = pm.response.json();",
                  "",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set(\"access_token\", res.access_token);",
                  "    console.log(\"✓ Đã tự động cập nhật access_token:\", res.access_token);",
                  "}",
                  "",
                  "if (res.refresh_token) {",
                  "    pm.collectionVariables.set(\"refresh_token\", res.refresh_token);",
                  "    console.log(\"✓ Đã lưu refresh_token:\", res.refresh_token);",
                  "}",
                  "",
                  "pm.test(\"Đăng nhập thành công (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response có chứa access_token\", function () {",
                  "    pm.expect(res.access_token).to.be.a(\"string\");",
                  "    pm.expect(res.access_token.length).to.be.above(20);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/plain, */*"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"rememberMe\": true,\n  \"signinType\": null,\n  \"otp\": null,\n  \"contactTrace\": \"{\\\"ip\\\":null,\\\"location\\\":null,\\\"deviceName\\\":null,\\\"deviceId\\\":null,\\\"timeTrace\\\":null,\\\"type\\\":null,\\\"latLong\\\":null,\\\"browser\\\":null,\\\"osVersion\\\":null}\"\n}"
            },
            "url": {
              "raw": "{{auth_host}}/auth/login",
              "host": [
                "{{auth_host}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Gửi yêu cầu đăng nhập. Postman Test script sẽ tự động trích xuất `access_token` từ response body và lưu vào biến collection `access_token` để tất cả các API khác kế thừa sử dụng ngay lập tức."
          }
        },
        {
          "name": "Làm mới Token (Refresh Token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{auth_host}}/auth/refresh-token",
              "host": [
                "{{auth_host}}"
              ],
              "path": [
                "auth",
                "refresh-token"
              ]
            },
            "description": "Dùng refresh_token để xin cấp lại access_token mới khi token cũ hết hạn."
          }
        },
        {
          "name": "Đăng xuất (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_host}}/auth/logout",
              "host": [
                "{{auth_host}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Hủy phiên làm việc hiện tại."
          }
        }
      ]
    },
