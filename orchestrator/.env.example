# ══ HƯỚNG 1 — SMOKE TEST GEMINI (không cần LiteLLM) ══
# Trỏ thẳng vào endpoint OpenAI-compatible của Gemini. Điền key Gemini của bạn.
LITELLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LITELLM_MASTER_KEY=dan-gemini-key-cua-ban-vao-day

# ══ HƯỚNG 2 — LiteLLM đầy đủ (bật sau, khi thêm Claude/đủ 4 vai) ══
# Khi chuyển sang LiteLLM thì đổi 2 dòng trên thành:
#   LITELLM_BASE_URL=http://localhost:4000
#   LITELLM_MASTER_KEY=sk-local-master
# và khai key từng hãng ở đây cho gateway đọc:
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...

# ── Đường tới kyta CLI (mặc định: repo cha) ──
KYTA_BIN=../bin/kyta.js

# ── Cổng dashboard ──
PORT=5178

# ── An toàn: MVP luôn dry-run. =1 để cho phép push thật (vẫn phải qua nút duyệt) ──
ALLOW_REAL_PUSH=0
