{
  "name": "kyta-orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kyta Swarm — Overseer điều phối nhiều agent quanh kyta-cli (local).",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "gateway": "litellm --config config/litellm.config.yaml --port 4000",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "js-yaml": "^4.3.2",
    "openai": "^4.67.0",
    "playwright-core": "^1.63.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
